{
  "name": "@buffmomo/zeditor",
  "version": "0.1.0",
  "description": "Extensible rich-text and block editor with classic and block modes. One engine; vanilla, React and Vue 3 integrations.",
  "license": "MIT",
  "author": "pushpa1105",
  "homepage": "https://pushpa1105.github.io/zed-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpa1105/zed-editor.git",
    "directory": "packages/zeditor"
  },
  "bugs": {
    "url": "https://github.com/pushpa1105/zed-editor/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "block-editor",
    "notion",
    "contenteditable",
    "markdown",
    "collaboration",
    "yjs",
    "react",
    "vue",
    "typescript"
  ],
  "type": "module",
  "sideEffects": ["*.css"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" },
    "./vue": { "types": "./dist/vue.d.ts", "import": "./dist/vue.js" },
    "./collab": { "types": "./dist/collab.d.ts", "import": "./dist/collab.js" },
    "./code-highlight": { "types": "./dist/code-highlight.d.ts", "import": "./dist/code-highlight.js" },
    "./browser": "./dist/zeditor.browser.js",
    "./collab/browser": "./dist/zeditor.collab.browser.js",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": "^3.3.0",
    "yjs": "^13.6.0",
    "y-protocols": "^1.0.6"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vue": { "optional": true },
    "yjs": { "optional": true },
    "y-protocols": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
