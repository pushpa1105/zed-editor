{
  "name": "zeditor-workspace",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm --filter @buffmomo/zeditor build",
    "build:examples": "pnpm --filter zeditor-example-react build && pnpm --filter zeditor-example-vue-vuetify build",
    "typecheck": "pnpm --filter @buffmomo/zeditor typecheck && pnpm --filter zeditor-example-react typecheck",
    "test": "pnpm --filter @buffmomo/zeditor test",
    "test:browser": "pnpm build:examples && pnpm --filter @buffmomo/zeditor test:browser",
    "playground": "node scripts/serve.mjs",
    "bench": "node scripts/bench.mjs",
    "pack:verify": "node scripts/pack-verify.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm docs:check && pnpm test && pnpm test:browser && pnpm pack:verify",
    "docs:api": "node scripts/api-docs.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve.mjs 4180 _site",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "marked": "^16.4.2"
  }
}
